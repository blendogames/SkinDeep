	bumpmap			textures/stbrielle/annex/brass_local.tga
	specularmap		textures/stbrielle/annex/brass_s.tga
}

textures/stbrielle/dev_burgundy
{
	qer_editorimage	textures/stbrielle/annex/paint_d.tga
	bumpmap			textures/stbrielle/annex/paint_local.tga
	{
		blend		diffusemap
		map			textures/stbrielle/annex/paint_d.tga
		color		0.62, 0.055, 0.090, 1
	}
	{
		blend		specularmap
		map			textures/stbrielle/annex/paint_s.tga
		color		0.32, 0.20, 0.20, 1
	}
}

