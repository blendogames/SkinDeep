// -----------------------------------------------------------------------------
// Engine bootstrap materials.
//
// The commercial data package normally supplies these declarations. St. Brielle
// defines its own standalone bootstrap plus original Municipal Annex materials.
// The Annex image maps are generated by tools/setup_annex_textures.ps1.
// -----------------------------------------------------------------------------

_default
{
	{
		map			_default
	}
}

_white
{
	{
		map			_white
	}
}

_tracemodel
{
	noShadows
}

console
{
	noShadows
	{
		blend		blend
		map			_black
		rgb			0.08
		alpha		1
	}
}

wipeMaterial
{
	noShadows
	{
		blend		blend
		alpha		parm3
		map			_black
		scale		1, -1
		translate	0, -1
	}
}

wipe2Material
{
	noShadows
	{
		blend		blend
		map			_black
		scale		1, -1
		translate	0, -1
		alpha		1.0 - parm3
	}
}

textures/bigchars
{
	// The commercial font atlas is not part of the public source release.
	noShadows
	{
		blend		blend
		map			_white
		rgba		0
	}
}

lights/defaultPointLight
{
	lightFalloffImage	_noFalloff
	{
		map			_white
		colored
	}
}

lights/defaultProjectedLight
{
	lightFalloffImage	_noFalloff
	{
		map			_white
		colored
	}
}

// -----------------------------------------------------------------------------
// Standalone development materials.
// These now use the same original surface library as the Annex so the greybox
// shell receives a texture pass without rewriting the map geometry.
// -----------------------------------------------------------------------------

textures/stbrielle/dev_wall
{
	qer_editorimage	textures/stbrielle/annex/plaster_d.tga
	diffusemap		textures/stbrielle/annex/plaster_d.tga
	bumpmap			textures/stbrielle/annex/plaster_local.tga
	specularmap		textures/stbrielle/annex/plaster_s.tga
}

textures/stbrielle/dev_floor
{
	qer_editorimage	textures/stbrielle/annex/tile_d.tga
