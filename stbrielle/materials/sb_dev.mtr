textures/stbrielle/dev_paper
{
    qer_editorimage textures/stbrielle/annex/paper_d.tga
    diffusemap textures/stbrielle/annex/paper_d.tga
    bumpmap textures/stbrielle/annex/paper_local.tga
    specularmap textures/stbrielle/annex/paper_s.tga
