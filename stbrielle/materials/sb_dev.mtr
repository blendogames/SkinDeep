textures/stbrielle/annex_cream
{
	qer_editorimage	textures/stbrielle/annex/paint_d.tga
	bumpmap			textures/stbrielle/annex/paint_local.tga
	{
		blend		diffusemap
		map			textures/stbrielle/annex/paint_d.tga
		color		1.00, 0.90, 0.72, 1
	}
	{
		blend		specularmap
		map			textures/stbrielle/annex/paint_s.tga
		color		0.20, 0.18, 0.14, 1
	}
}

