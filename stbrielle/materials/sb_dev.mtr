{
	qer_editorimage	_white
	noShadows
	{
		map			_white
		color		0.7, 0.82, 1, 1
	}
}

// -----------------------------------------------------------------------------
// MUNICIPAL ANNEX ARCHITECTURAL PALETTE
// Original generated diffuse / normal / specular maps. Material names remain
// stable so later art revisions can replace image maps without touching maps.
// -----------------------------------------------------------------------------

textures/stbrielle/annex_stone
{
	qer_editorimage	textures/stbrielle/annex/stone_d.tga
	diffusemap		textures/stbrielle/annex/stone_d.tga
	bumpmap			textures/stbrielle/annex/stone_local.tga
	specularmap		textures/stbrielle/annex/stone_s.tga
}

