{
	qer_editorimage	textures/stbrielle/annex/wood_d.tga
	diffusemap		textures/stbrielle/annex/wood_d.tga
	bumpmap			textures/stbrielle/annex/wood_local.tga
	specularmap		textures/stbrielle/annex/wood_s.tga
