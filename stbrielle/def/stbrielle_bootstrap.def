entityDef func_static {
	"spawnclass" "idStaticEntity"
}

// ST. BRIELLE standalone bootstrap entity declarations.
// These definitions intentionally contain only what the current greybox
// systems laboratory needs.

entityDef worldspawn {
	"spawnclass" "idWorldspawn"
}

