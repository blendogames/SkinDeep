	"spawnclass" "idPlayerStart"
}

entityDef trigger_once {
	"spawnclass" "idTrigger_Multi"
	"wait" "-1"
}

entityDef light {
	"spawnclass" "idLight"
}

entityDef target_endlevel {
	"spawnclass" "idTarget_EndLevel"
	"noGui" "1"
}

